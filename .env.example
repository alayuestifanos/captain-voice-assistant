# Copy this file to .env and configure ONE LLM backend (all three are
# free or effectively free to try):
#   - GROQ_API_KEY      free tier, no credit card -- console.groq.com/keys
#   - ANTHROPIC_API_KEY paid, for Claude quality instead
#   - (nothing)         falls back to a local Ollama server -- no signup/
#                       key/CAPTCHA at all, just `ollama pull llama3.1`
#                       once (see https://ollama.com/download)
# Everything else below upgrades quality/coverage incrementally.

# --- LLM (required): grounded generation + LLM-based translation ----------
# auto (default) uses Groq if GROQ_API_KEY is set, else Anthropic if
# ANTHROPIC_API_KEY is set, else a local Ollama server. Set explicitly to
# force one: groq | anthropic | ollama
LLM_PROVIDER=auto
LLM_MAX_TOKENS=600

# Groq (free tier -- no credit card required)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss is a reasoning model -- caps hidden "thinking" tokens so it
# doesn't burn the whole budget on reasoning and return an empty answer.
GROQ_REASONING_EFFORT=low

# Anthropic / Claude (optional, pluggable alternative to Groq)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ollama (fully local, no signup/key/CAPTCHA -- https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Retrieval --------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=4
RELEVANCE_THRESHOLD=0.30

# --- Translation --------------------------------------------------------------
# Default target language for responses (ISO-ish code). See
# app/translation/translator.py:LANGUAGE_NAMES for supported codes.
DEFAULT_TARGET_LANG=am

# --- TTS ("Captain" voice) ----------------------------------------------------
# auto (default) picks the best available backend: elevenlabs > azure > local.
# Set explicitly to force one: elevenlabs | azure | local
TTS_ENGINE=auto

# ElevenLabs (true voice cloning) -- see scripts/clone_voice.py
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Azure Speech (recommended for Amharic -- has dedicated am-ET neural voices)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Local pyttsx3 fallback (no key needed, always available)
LOCAL_VOICE_NAME=
LOCAL_VOICE_RATE=170

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
