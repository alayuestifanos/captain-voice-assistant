# Copy this file to .env and fill in your keys.

# --- LLM (required): grounded generation + LLM-based translation ----------
LLM_PROVIDER=auto
LLM_MAX_TOKENS=600

# Groq (free tier -- no credit card required -- console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss is a reasoning model -- caps hidden "thinking" tokens so it
# doesn't burn the whole budget on reasoning and return an empty answer.
GROQ_REASONING_EFFORT=low

# --- Retrieval --------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=4
RELEVANCE_THRESHOLD=0.30

# --- Translation --------------------------------------------------------------
# Default target language for responses (ISO-ish code). See
# app/translation/translator.py:LANGUAGE_NAMES for supported codes.
DEFAULT_TARGET_LANG=am

# --- TTS ("Captain" voice) ----------------------------------------------------
TTS_ENGINE=auto

# ElevenLabs -- see scripts/clone_voice.py
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
